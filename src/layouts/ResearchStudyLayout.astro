---
import BaseLayout from "./BaseLayout.astro";

const { frontmatter } = Astro.props;
const title = frontmatter.title as string;
const description = frontmatter.description as string;
const subtitle = frontmatter.subtitle as string | undefined;
const kicker = frontmatter.kicker as string | undefined;
const draftLabel = frontmatter.draftLabel as string | undefined;
const pubDate = frontmatter.pubDate as string | undefined;
const author = frontmatter.author as string | undefined;
// Studies show the suicide/self-harm content warning unless they opt out with
// `contentWarning: false` in frontmatter (keeps the original study unchanged).
const showSuicideWarning = frontmatter.contentWarning !== false;
---

<BaseLayout title={title} description={description}>
  <article>
    <header class="border-b border-rule">
      <div class="mx-auto max-w-6xl px-5 py-10 sm:px-8 sm:py-14">
        <p class="kicker mb-3">
          <a class="text-muted no-underline hover:text-oxblood" href="/research">Research</a>
          {
            kicker && (
              <>
                <span aria-hidden="true"> · </span>
                <span>{kicker.replace(/^Research study\s*·\s*/i, "")}</span>
              </>
            )
          }
        </p>
        {
          draftLabel && (
            <p class="mb-4 inline-block border border-rule bg-paper-raised px-2.5 py-1 font-sans text-xs font-semibold uppercase tracking-wider text-ink-soft">
              {draftLabel}
            </p>
          )
        }
        <h1 class="font-display max-w-4xl text-4xl leading-[1.1] tracking-tight text-ink sm:text-5xl">
          {title}
        </h1>
        {
          subtitle && (
            <p class="measure mt-4 font-serif text-xl text-ink-soft sm:text-2xl">{subtitle}</p>
          )
        }
        {
          pubDate && (
            <p class="mt-5 font-sans text-sm text-muted">
              Center for the Study of Anomalous Virtues{author && <> · {author}</>} · {pubDate}
            </p>
          )
        }
      </div>
    </header>

    <div class="mx-auto max-w-6xl px-5 py-8 sm:px-8">
      {
        showSuicideWarning && (
          <aside
            class="measure border border-oxblood/40 bg-paper-raised px-4 py-4 font-sans text-sm leading-relaxed text-ink-soft sm:px-5"
            role="note"
            aria-label="Content warning"
          >
            <p class="font-semibold uppercase tracking-wide text-oxblood">Content warning</p>
            <p class="mt-2">
              This page discusses suicide and self-harm in an academic, comparative-historical
              frame only. It does <strong class="font-semibold text-ink">not</strong> offer advice,
              encouragement, methods, or endorsement of suicide, self-harm, terrorism, or the
              taking of life.
            </p>
            <p class="mt-2">
              If you are in crisis, help is available. In the United States, call or text
              <strong class="font-semibold text-ink">988</strong> (Suicide &amp; Crisis Lifeline).
              International resources:{" "}
              <a
                class="text-oxblood underline-offset-2 hover:underline"
                href="https://www.iasp.info/suicidalthoughts/"
                rel="noopener noreferrer"
                target="_blank"
              >
                iasp.info
              </a>.
            </p>
          </aside>
        )
      }

      <div class:list={["measure prose-cav prose-cav-study text-[1.05rem]", showSuicideWarning ? "mt-10" : "mt-2"]}>
        <slot />
      </div>

      <p class="measure mt-12 font-sans text-sm text-muted">
        <a class="text-oxblood underline-offset-2 hover:underline" href="/research">
          ← Return to Research
        </a>
      </p>
    </div>
  </article>
</BaseLayout>
