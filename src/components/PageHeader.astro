---
interface Props {
  kicker?: string;
  title: string;
  lede?: string;
}

const { kicker, title, lede } = Astro.props;
---

<header class="border-b border-rule">
  <div class="mx-auto max-w-6xl px-5 py-10 sm:px-8 sm:py-14">
    {kicker && <p class="kicker mb-3">{kicker}</p>}
    <h1 class="font-display max-w-4xl text-4xl leading-[1.1] tracking-tight text-ink sm:text-5xl">
      {title}
    </h1>
    {lede && <p class="measure mt-5 text-lg text-ink-soft sm:text-xl">{lede}</p>}
  </div>
</header>
