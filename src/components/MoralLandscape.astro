---
/**
 * Moral Landscape figure: an original SVG built at build time from the
 * published catalog entries' frontmatter (term, group, pillars). It shows
 * which research pillars each published entry is tagged with. No numbers
 * are invented: every mark and total comes from src/content/catalog.
 */
import type { CatalogEntry } from "../data/catalog";
import { catalogGroups } from "../data/catalog";
import { pillarColumns } from "../data/pillars";

interface Props {
  entries: CatalogEntry[];
  /** Figure number shown in the caption heading. */
  figure?: string;
  id?: string;
}

const { entries, figure = "Fig. 1", id = "moral-landscape" } = Astro.props;
const columns = pillarColumns(entries.map((e) => e.data.pillars));

const labelW = 172;
const colW = 64;
const rowH = 34;
const headH = 48;
const groupH = 26;
const footH = 40;

type Row =
  | { kind: "group"; title: string; y: number }
  | { kind: "entry"; entry: CatalogEntry; y: number };

const rows: Row[] = [];
let y = headH;
for (const group of catalogGroups) {
  const groupEntries = entries.filter((e) => e.data.group === group.id);
  if (groupEntries.length === 0) continue;
  rows.push({ kind: "group", title: group.title, y });
  y += groupH;
  for (const entry of groupEntries) {
    rows.push({ kind: "entry", entry, y });
    y += rowH;
  }
}
const totalsY = y;
const width = labelW + columns.length * colW + 12;
const height = totalsY + footH;
const totals = columns.map((c) => entries.filter((e) => e.data.pillars.includes(c.name)).length);
const colX = (i: number) => labelW + i * colW + colW / 2;

const summary = `${entries.length} published catalog entries plotted against ${columns.length} research pillars. ${columns
  .map((c, i) => `${c.name}: ${totals[i]} of ${entries.length}`)
  .join("; ")}.`;
---

<figure class="atlas-plate print-avoid-break p-4 sm:p-5" aria-labelledby={`${id}-title`}>
  <div class="mb-3 flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1 border-b border-rule pb-2 font-sans">
    <p id={`${id}-title`} class="text-[0.78rem] font-bold uppercase tracking-[0.1em] text-ink">
      {figure} · The moral landscape of the catalog
    </p>
    <p class="text-[0.75rem] text-ink-soft">
      {entries.length} published entries · {columns.length} research pillars
    </p>
  </div>
  <div>
    <svg
      viewBox={`0 0 ${width} ${height}`}
      width={width}
      height={height}
      class="block h-auto w-full"
      role="img"
      aria-label={summary}
    >
      <rect x="0" y="0" width={width} height={height} fill="#f8f4ec" />
      {
        columns.map((c, i) => (
          <g>
            <rect x={labelW + i * colW + 3} y={headH - 6} width={colW - 6} height={totalsY - headH + 12} fill={i % 2 === 0 ? "#f3eee4" : "#f8f4ec"} />
            <text x={colX(i)} y={headH - 16} text-anchor="middle" font-family="Source Sans 3, sans-serif" font-size="12" font-weight="700" fill="#1a1814">
              {c.short}
            </text>
          </g>
        ))
      }
      {
        rows.map((row) =>
          row.kind === "group" ? (
            <text x="8" y={row.y + 17} font-family="Source Sans 3, sans-serif" font-size="10.5" font-weight="700" letter-spacing="1" fill="#6e2a2a">
              {row.title.toUpperCase()}
            </text>
          ) : (
            <g>
              <line x1="8" y1={row.y + rowH} x2={width - 8} y2={row.y + rowH} stroke="#dfd6c5" stroke-width="1" />
              <text x="8" y={row.y + 21} font-family="Fraunces, Georgia, serif" font-size="14" font-weight="600" fill="#1a1814">
                {row.entry.data.term}
              </text>
              {columns.map((c, i) =>
                row.entry.data.pillars.includes(c.name) ? (
                  <circle cx={colX(i)} cy={row.y + rowH / 2} r="8" fill="#6e2a2a" stroke="#1a1814" stroke-width="1" />
                ) : (
                  <circle cx={colX(i)} cy={row.y + rowH / 2} r="2" fill="#a59c8c" />
                ),
              )}
            </g>
          ),
        )
      }
      <line x1="8" y1={totalsY + 6} x2={width - 8} y2={totalsY + 6} stroke="#1a1814" stroke-width="1.4" />
      <text x="8" y={totalsY + 28} font-family="Source Sans 3, sans-serif" font-size="11" font-weight="700" letter-spacing="0.8" fill="#3d3830">
        ENTRIES TAGGED
      </text>
      {
        totals.map((t, i) => (
          <text x={colX(i)} y={totalsY + 28} text-anchor="middle" font-family="Source Sans 3, sans-serif" font-size="13" font-weight="700" fill="#1a1814">
            {t}
          </text>
        ))
      }
    </svg>
  </div>
  <figcaption class="mt-3 border-t border-rule pt-2 font-sans text-[0.8rem] leading-snug text-ink-soft">
    <span class="mr-4 inline-flex items-center gap-1.5">
      <svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true"><circle cx="7" cy="7" r="6" fill="#6e2a2a" stroke="#1a1814" stroke-width="1" /></svg>
      Large filled mark: entry is tagged with this pillar
    </span>
    <span class="mr-4 inline-flex items-center gap-1.5">
      <svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true"><circle cx="7" cy="7" r="2" fill="#a59c8c" /></svg>
      Small dot: not tagged
    </span>
    <span class="mt-1 block">
      Source: pillar tags in each published catalog entry. Columns:
      {columns.map((c, i) => `${c.short} = ${c.name}`).join("; ")}.
    </span>
  </figcaption>
  <details class="atlas-data mt-3 font-sans text-sm">
    <summary class="cursor-pointer text-oxblood underline underline-offset-2">Show the chart data as a table</summary>
    <div class="atlas-scroll mt-2" tabindex="0" role="region" aria-label="Moral landscape data table">
      <table class="atlas-table">
        <caption class="sr-only">Research pillars tagged for each published catalog entry</caption>
        <thead>
          <tr>
            <th scope="col">Entry</th>
            <th scope="col">Language</th>
            <th scope="col">Pillars</th>
          </tr>
        </thead>
        <tbody>
          {
            entries.map((e) => (
              <tr>
                <th scope="row" class="font-semibold text-ink">
                  <a class="text-oxblood underline-offset-2 hover:underline" href={`/catalog/${e.id}/`}>{e.data.term}</a>
                </th>
                <td>{e.data.language}</td>
                <td>{e.data.pillars.join(", ")}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </details>
</figure>
