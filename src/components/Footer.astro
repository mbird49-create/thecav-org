    <div>
      <p class="font-display text-xl tracking-tight">CAV</p>
      <p class="mt-2 max-w-md text-[0.95rem] text-ink-soft">
        The Center for the Study of Anomalous Virtues is a Utah nonprofit corporation
        studying highly specific cultural concepts of moral excellence as diplomatic
        infrastructure.
      </p>
    </div>
    <div class="font-sans text-sm text-ink-soft">
      <p>
        EIN <span class="text-ink">42-5016729</span>
      </p>
      <p class="mt-1">thecav.org · cav.ngo</p>
      <p class="mt-1">
        <a class="text-oxblood underline-offset-2 hover:underline" href="mailto:contact@thecav.org">contact@thecav.org</a>
      </p>
      <p class="mt-6 text-muted">© {year} The Center for the Study of Anomalous Virtues</p>
    </div>
  </div>
</footer>
