---
import { navItems, isCurrentPath } from "../data/nav";

const pathname = Astro.url.pathname;
---

<header class="border-b border-rule">
  <div class="mx-auto flex max-w-6xl flex-col gap-4 px-5 py-4 sm:px-8 lg:flex-row lg:items-center lg:justify-between">
    <a href="/" class="group flex items-center gap-3 no-underline sm:gap-4">
      <img
        src="/cav-logo.png"
        alt="Center for the Study of Anomalous Virtues"
        width="72"
        height="72"
        class="h-14 w-14 shrink-0 rounded-full object-cover object-[center_28%] shadow-sm ring-1 ring-rule sm:h-[4.5rem] sm:w-[4.5rem]"
      />
      <span class="min-w-0">
        <span class="kicker mb-1 block">The Center for the Study of</span>
        <span class="font-display block text-[1.65rem] leading-none tracking-tight text-ink sm:text-3xl">
          Anomalous Virtues
        </span>
      </span>
    </a>
    <nav aria-label="Primary">
      <ul class="flex flex-wrap gap-x-5 gap-y-2 font-sans text-[0.95rem]">
        {
          navItems.map((item) => {
            const current = isCurrentPath(pathname, item.href);
            return (
              <li>
                <a
                  href={item.href}
                  class:list={[
                    "inline-block border-b py-0.5 no-underline transition-colors",
                    current
                      ? "border-oxblood text-oxblood"
                      : "border-transparent text-ink-soft hover:border-rule hover:text-ink",
                  ]}
                  aria-current={current ? "page" : undefined}
                >
                  {item.label}
                </a>
              </li>
            );
          })
        }
      </ul>
    </nav>
  </div>
</header>
