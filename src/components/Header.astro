---
import { navItems, isCurrentPath } from "../data/nav";

const pathname = Astro.url.pathname;
---

<header class="border-b border-rule">
  <div class="mx-auto flex max-w-6xl flex-col gap-4 px-5 py-4 sm:px-8 lg:flex-row lg:items-end lg:justify-between">
    <div class="flex items-baseline justify-between gap-4">
      <a href="/" class="group block no-underline">
        <p class="kicker mb-1">The Center for the Study of</p>
        <p class="font-display text-[1.65rem] leading-none tracking-tight text-ink sm:text-3xl">
          Anomalous Virtues
        </p>
      </a>
      <span class="hidden font-sans text-xs tracking-[0.18em] text-muted uppercase sm:inline lg:hidden">CAV</span>
    </div>
    <nav aria-label="Primary">
      <ul class="flex flex-wrap gap-x-5 gap-y-2 font-sans text-[0.95rem]">
        {
          navItems.map((item) => {
            const current = isCurrentPath(pathname, item.href);
            return (
              <li>
                <a
                  href={item.href}
                  class:list={[
                    "inline-block border-b py-0.5 no-underline transition-colors",
                    current
                      ? "border-oxblood text-oxblood"
                      : "border-transparent text-ink-soft hover:border-rule hover:text-ink",
                  ]}
                  aria-current={current ? "page" : undefined}
                >
                  {item.label}
                </a>
              </li>
            );
          })
        }
      </ul>
    </nav>
  </div>
</header>
