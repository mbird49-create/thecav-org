---
import { navItems, isCurrentPath } from "../data/nav";

const pathname = Astro.url.pathname;
---

<header class="border-b border-rule">
  <div class="mx-auto flex max-w-6xl flex-col gap-5 px-5 py-5 sm:px-8 lg:flex-row lg:items-center lg:justify-between lg:gap-8">
    <a href="/" class="group block w-fit max-w-full no-underline">
      <img
        src="/cav-logo.png"
        alt="Center for the Study of Anomalous Virtues"
        width="1536"
        height="1024"
        class="h-44 w-auto max-w-full object-contain sm:h-52 lg:h-60"
      />
    </a>
    <nav aria-label="Primary" class="lg:pt-2">
      <ul class="flex flex-wrap gap-x-5 gap-y-2 font-sans text-[0.95rem]">
        {
          navItems.map((item) => {
            const current = isCurrentPath(pathname, item.href);
            return (
              <li>
                <a
                  href={item.href}
                  class:list={[
                    "inline-block border-b py-0.5 no-underline transition-colors",
                    current
                      ? "border-oxblood text-oxblood"
                      : "border-transparent text-ink-soft hover:border-rule hover:text-ink",
                  ]}
                  aria-current={current ? "page" : undefined}
                >
                  {item.label}
                </a>
              </li>
            );
          })
        }
      </ul>
    </nav>
  </div>
</header>
