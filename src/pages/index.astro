---
import BaseLayout from "../layouts/BaseLayout.astro";
import MoralLandscape from "../components/MoralLandscape.astro";
import SpecimenCard from "../components/SpecimenCard.astro";
import { getCatalogEntries } from "../data/catalog";
import { SPECIMEN_BANDS } from "../data/pillars";

// Same three entries the home page featured before the catalog migration.
const featured = ["philotimo", "amae", "sisu"];
const published = await getCatalogEntries();
const samples = published.filter((entry) => featured.includes(entry.id));

const pillars = [
  {
    n: "01",
    icon: "globe",
    name: "Ethno-Ethics",
    title: "Cultural & Geographical Variations",
    blurb:
      "How landscapes, scarcity, honor versus dignity cultures, and collectivism versus individualism shape moral expectations.",
  },
  {
    n: "02",
    icon: "arch",
    name: "Sacred Axiology",
    title: "Religious & Theological Foundations",
    blurb:
      "Divine-command traditions, karmic and immanent cosmologies, and secular humanist ethics as distinct moral architectures.",
  },
  {
    n: "03",
    icon: "bridge",
    name: "Semantic Ethics",
    title: "Linguistic Relativity in Morals",
    blurb:
      "Untranslatable virtues and the grammatical framing of blame, obligation, and excellence: precise bridges where generic language fails.",
  },
  {
    n: "04",
    icon: "arc",
    name: "Chronological Ethics",
    title: "Temporal & Historical Evolution",
    blurb:
      "Axial Age convergences and the long arc from warrior virtues through Enlightenment ideals to digital-era moral pressures.",
  },
];
---

<BaseLayout
  title="The Center for the Study of Anomalous Virtues"
  description="CAV is a hybrid human-AI research organization mapping the philosophical and ethical underpinnings of moral values across human demographics: computational humanities, comparative philosophy, and evolutionary ethics."
  ogTitle="The Center for the Study of Anomalous Virtues"
>

  <section class="atlas-grid border-b-[1.5px] border-ink">
    <div class="mx-auto grid max-w-6xl gap-10 px-5 py-12 sm:px-8 sm:py-14 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.05fr)] lg:items-start lg:py-16">
      <div class="min-w-0">
      <p class="atlas-kicker mb-4">Vol. I · Founding statement</p>
      <h1 class="font-display max-w-4xl text-4xl leading-[1.08] tracking-tight sm:text-5xl lg:text-[3.1rem]">
        Precise bridges where generic language fails.
      </h1>
      <p class="measure mt-6 text-lg text-ink-soft">
        The Center for the Study of Anomalous Virtues (CAV) is a hybrid human-AI research
        organization that maps, analyzes, and synthesizes the philosophical and ethical
        underpinnings of moral values across human demographics.
      </p>
      <blockquote class="measure mt-6 border border-rule border-l-[3px] border-l-oxblood bg-paper px-5 py-4 sm:px-6">
        <p class="font-display text-lg leading-snug tracking-tight text-ink sm:text-xl">
          Do you sense that societies throughout the world exhibit less civility,
          manifest more violence as well as a greater obsession with sex, and have
          more extreme and less flexible views?
        </p>
        <p class="mt-4 font-display text-lg leading-snug tracking-tight text-ink sm:text-xl">
          The mission of CAV is to document and study the evolution of the moral
          landscape, grounding it in human common sense and lived experience, using
          artificial intelligence to facilitate, deepen, and scale open inquiry.
        </p>
      </blockquote>
      <p class="no-print mt-6 flex flex-wrap gap-3 font-sans text-sm font-semibold">
        <a class="bg-navy px-4 py-2.5 text-paper-raised no-underline hover:bg-navy-deep" href="/catalog/">Open the catalog</a>
        <a class="border border-oxblood bg-paper-raised px-4 py-2.5 text-oxblood no-underline hover:bg-paper" href="/research/">Read the research</a>
      </p>
      </div>
      <div class="min-w-0">
        <MoralLandscape entries={published} />
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-5 py-12 sm:px-8 sm:py-16">
    <div class="measure prose-cav text-[1.05rem] sm:text-lg">
      <p>
        We work at the intersection of <em>computational humanities</em>,
        <em>comparative philosophy</em>, and <em>evolutionary ethics</em>. The open
        question is whether humanity shares a unified moral grammar, or whether values
        are fundamentally relative to language, place, history, and creed.
      </p>
      <p>
        An <em>anomalous virtue</em> is a moral quality, strength, or excellent trait
        that departs from the norm of its setting: it is unusual, unexpected, or
        contradictory there, or it does not carry into another moral vocabulary,
        including the portable English of values training, without remainder. Whether
        a virtue is anomalous in a given group is tested relatively: we compare that
        group with matched comparison groups, using the same definition and the same
        kinds of records. Where comparison data are missing, we say the question is
        untested. Studies also report the actual figures or ceilings, with 50%
        (minority versus majority) as the only marked line.
      </p>
      <p>
        Candidates include untranslatable culture-words under Semantic Ethics, but also
        philosophy and ethics (honor among thieves, flawed heroes, contextual virtues)
        and literature and character design: the sympathetic villain, the reluctant
        savior. The phrase is not a single classical ethics term; it names a working
        object at the intersection of those discourses.
      </p>
      <p>
        Specialized expertise remains indispensable for a complex civilization. What we
        resist is <em>technocracy</em>, expertise pressed into service as a mechanism
        for ruling rather than informing, and any use of AI that would replace human
        judgment instead of widening the circle of inquiry. Fuller treatment appears on
        <a href="/about">About</a> and <a href="/research">Research</a>.
      </p>
    </div>

    <div class="mt-14 border-t border-rule pt-10">
      <h2 class="font-display text-2xl tracking-tight">Research pillars</h2>
      <p class="mt-3 max-w-3xl text-ink-soft">
        Four analytic pillars structure the research program. A fifth strand,
        <a class="text-oxblood underline-offset-2 hover:underline" href="/practice">Practice</a>,
        applies findings through training, diplomacy, and institutions without
        overclaiming what the research has not yet established.
      </p>
      <ol class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {
          pillars.map((p, i) => (
            <li class:list={["print-avoid-break flex flex-col gap-2 border border-rule border-t-[3px] bg-paper-raised p-5", i % 2 === 0 ? "border-t-navy" : "border-t-oxblood"]}>
              <div class="flex items-center justify-between gap-3">
                <p class="font-sans text-xs font-bold uppercase tracking-[0.1em] text-ink-soft">
                  {p.n} · {p.name}
                </p>
                <svg class="h-10 w-10 shrink-0" viewBox="0 0 42 42" aria-hidden="true">
                  {p.icon === "globe" && (
                    <g fill="none">
                      <circle cx="21" cy="21" r="17" stroke="#24305e" stroke-width="1.5" />
                      <ellipse cx="21" cy="21" rx="17" ry="7" stroke="#a88234" stroke-width="1.2" />
                      <line x1="21" y1="4" x2="21" y2="38" stroke="#24305e" stroke-width="1.2" />
                    </g>
                  )}
                  {p.icon === "arch" && (
                    <g>
                      <path d="M9 34V19a12 12 0 0 1 24 0v15" fill="none" stroke="#6e2a2a" stroke-width="2" />
                      <line x1="6" y1="34" x2="36" y2="34" stroke="#1a1814" stroke-width="1.5" />
                      <circle cx="21" cy="19" r="3.5" fill="#a88234" />
                    </g>
                  )}
                  {p.icon === "bridge" && (
                    <g>
                      <circle cx="12" cy="25" r="5" fill="#24305e" />
                      <circle cx="30" cy="25" r="5" fill="#6e2a2a" />
                      <path d="M12 20q9-12 18 0" fill="none" stroke="#a88234" stroke-width="2" stroke-dasharray="2.5 2.5" />
                    </g>
                  )}
                  {p.icon === "arc" && (
                    <g>
                      <line x1="6" y1="30" x2="36" y2="30" stroke="#c4baa8" stroke-width="1.5" />
                      <path d="M7 28c6-1 9-3 12-8s8-9 16-10" fill="none" stroke="#6e2a2a" stroke-width="2" />
                      <circle cx="19" cy="20" r="3" fill="#24305e" />
                      <circle cx="35" cy="10" r="3" fill="#6e2a2a" />
                    </g>
                  )}
                </svg>
              </div>
              <h3 class="font-display text-xl leading-tight tracking-tight">{p.title}</h3>
              <p class="text-sm text-ink-soft">{p.blurb}</p>
            </li>
          ))
        }
      </ol>
      <p class="mt-6">
        <a class="font-sans text-sm text-oxblood underline-offset-2 hover:underline" href="/research">
          Methods and working hypotheses
        </a>
      </p>
    </div>

    <div class="mt-14 border-t border-rule pt-10">
      <div>
        <h2 class="font-display text-2xl tracking-tight">What we do</h2>
        <ol class="mt-5 grid gap-x-10 gap-y-5 md:grid-cols-2">
          <li class="grid grid-cols-[2.5rem_1fr] gap-3">
            <span class="font-sans text-sm text-muted">01</span>
            <div>
              <p class="font-medium">Map and analyze</p>
              <p class="mt-1 text-ink-soft">
                Document how moral concepts vary across culture, theology, language,
                and historical period, with human scholarship and computational methods
                in dialogue.
              </p>
            </div>
          </li>
          <li class="grid grid-cols-[2.5rem_1fr] gap-3">
            <span class="font-sans text-sm text-muted">02</span>
            <div>
              <p class="font-medium">Synthesize without false unity</p>
              <p class="mt-1 text-ink-soft">
                Over time, test provisional claims about shared moral baselines against contextual
                overlays, without erasing remainder into a single portable vocabulary.
              </p>
            </div>
          </li>
          <li class="grid grid-cols-[2.5rem_1fr] gap-3">
            <span class="font-sans text-sm text-muted">03</span>
            <div>
              <p class="font-medium">Keep Semantic Ethics precise</p>
              <p class="mt-1 text-ink-soft">
                Treat untranslatable virtues as linguistic evidence, not souvenirs.
                Build precise bridges where generic language fails.
              </p>
            </div>
          </li>
          <li class="grid grid-cols-[2.5rem_1fr] gap-3">
            <span class="font-sans text-sm text-muted">04</span>
            <div>
              <p class="font-medium">Engage practice carefully</p>
              <p class="mt-1 text-ink-soft">
                Support diplomats, mediators, and institutions only where research
                standing exists: practice follows method, not the reverse.
              </p>
            </div>
          </li>
        </ol>
      </div>
    </div>

    <section class="mt-14 border-t border-rule pt-10" aria-labelledby="home-catalog">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div>
          <p class="atlas-kicker">From the catalog</p>
          <h2 id="home-catalog" class="mt-2 font-display text-2xl tracking-tight">Catalog entries</h2>
          <p class="mt-3 max-w-2xl text-ink-soft">
            Sourced entries on untranslatable virtues and culturally specific forms of
            forgiveness and reconciliation, under ongoing review.
          </p>
        </div>
        <a class="font-sans text-sm font-semibold text-oxblood underline-offset-2 hover:underline" href="/catalog">
          Open the catalog
        </a>
      </div>
      <ul class="mt-8 grid gap-6 md:grid-cols-3">
        {
          samples.map((entry, i) => (
            <li>
              <SpecimenCard entry={entry} band={SPECIMEN_BANDS[i % SPECIMEN_BANDS.length]} />
            </li>
          ))
        }
      </ul>
    </section>
  </section>
</BaseLayout>
