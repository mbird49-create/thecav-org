---
import BaseLayout from "../layouts/BaseLayout.astro";
import { catalogEntries } from "../data/catalog";

const samples = catalogEntries.slice(0, 3);
---

<BaseLayout
  title="The Center for the Study of Anomalous Virtues"
  description="CAV studies anomalous virtues — highly specific, often untranslatable cultural concepts of moral excellence — as diplomatic infrastructure."
  ogTitle="The Center for the Study of Anomalous Virtues"
>
  <section class="border-b border-rule">
    <div class="mx-auto max-w-6xl px-5 py-12 sm:px-8 sm:py-16 lg:py-20">
      <p class="kicker mb-4">Vol. I · Founding statement</p>
      <h1 class="font-display max-w-4xl text-4xl leading-[1.08] tracking-tight sm:text-5xl lg:text-[3.35rem]">
        Precise bridges where generic language fails.
      </h1>
      <p class="measure mt-8 text-lg text-ink-soft sm:text-xl">
        Most diplomacy starts from shared words — respect, kindness, dignity. Those words
        travel easily. They also flatten what makes cultures distinct.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-5 py-12 sm:px-8 sm:py-16">
    <div class="measure prose-cav text-[1.05rem] sm:text-lg">
      <p>
        CAV studies <em>anomalous virtues</em>: highly specific, often untranslatable
        cultural concepts that name a rare form of moral excellence or emotional
        intelligence. We treat these as diplomatic infrastructure — instruments precise
        enough to carry meaning where a shared vocabulary of values cannot.
      </p>
      <p>
        A word that will not sit still in English is not a curiosity. It is a map of a
        moral world. To lose the edge of that word in translation is to lose a possible
        settlement, a possible apology, a possible form of care.
      </p>
    </div>

    <div class="mt-14 grid gap-8 border-t border-rule pt-10 md:grid-cols-2">
      <div>
        <h2 class="font-display text-2xl tracking-tight">What we do</h2>
        <ol class="mt-5 space-y-5">
          <li class="grid grid-cols-[2.5rem_1fr] gap-3">
            <span class="font-sans text-sm text-muted">01</span>
            <div>
              <p class="font-medium">Research and document</p>
              <p class="mt-1 text-ink-soft">
                Study concepts in their home languages and practices, with the people
                who live them.
              </p>
            </div>
          </li>
          <li class="grid grid-cols-[2.5rem_1fr] gap-3">
            <span class="font-sans text-sm text-muted">02</span>
            <div>
              <p class="font-medium">Translate without erasing edge</p>
              <p class="mt-1 text-ink-soft">
                Resist premature equivalence. Keep what does not map cleanly in view.
              </p>
            </div>
          </li>
          <li class="grid grid-cols-[2.5rem_1fr] gap-3">
            <span class="font-sans text-sm text-muted">03</span>
            <div>
              <p class="font-medium">Train diplomats, mediators, and institutions</p>
              <p class="mt-1 text-ink-soft">
                Teach field methods for hearing a virtue that English does not already
                own.
              </p>
            </div>
          </li>
          <li class="grid grid-cols-[2.5rem_1fr] gap-3">
            <span class="font-sans text-sm text-muted">04</span>
            <div>
              <p class="font-medium">Publish a living catalog and field methods</p>
              <p class="mt-1 text-ink-soft">
                Keep a public record that can be corrected, deepened, and locally
                governed.
              </p>
            </div>
          </li>
        </ol>
      </div>
      <aside class="border border-rule bg-paper-raised p-6 sm:p-8">
        <p class="kicker">From the catalog</p>
        <p class="mt-3 font-display text-2xl tracking-tight">Illustrative entries</p>
        <p class="mt-3 text-sm text-ink-soft">
          Samples of form, not finished monographs. Each is a real, well-known concept
          marked as an example.
        </p>
        <ul class="mt-6 divide-y divide-rule">
          {
            samples.map((entry) => (
              <li class="py-3 first:pt-0 last:pb-0">
                <a class="group block no-underline" href={`/catalog/${entry.slug}`}>
                  <p class="font-display text-lg text-ink group-hover:text-oxblood">
                    {entry.term}
                    <span class="ml-2 font-serif text-base text-muted">{entry.native}</span>
                  </p>
                  <p class="mt-1 text-sm text-ink-soft">{entry.language}</p>
                </a>
              </li>
            ))
          }
        </ul>
        <p class="mt-6">
          <a class="font-sans text-sm text-oxblood underline-offset-2 hover:underline" href="/catalog">
            Open the catalog
          </a>
        </p>
      </aside>
    </div>
  </section>
</BaseLayout>
