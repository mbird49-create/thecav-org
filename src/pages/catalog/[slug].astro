---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { catalogEntries, type CatalogEntry } from "../../data/catalog";

export function getStaticPaths() {
  return catalogEntries.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

interface Props {
  entry: CatalogEntry;
}

const { entry } = Astro.props;
---

<BaseLayout
  title={`${entry.term} — Catalog`}
  description={`${entry.term} (${entry.native}): ${entry.gloss}`}
>
  <article>
    <header class="border-b border-rule">
      <div class="mx-auto max-w-6xl px-5 py-10 sm:px-8 sm:py-14">
        <p class="kicker mb-3">
          <a class="text-muted no-underline hover:text-oxblood" href="/catalog">Catalog</a>
          <span aria-hidden="true"> · </span>
          Illustrative example
        </p>
        <h1 class="font-display text-4xl tracking-tight sm:text-5xl">
          {entry.term}
          <span class="mt-2 block font-serif text-2xl text-muted sm:text-3xl">{entry.native}</span>
        </h1>
        <p class="measure mt-5 text-lg text-ink-soft sm:text-xl">{entry.gloss}</p>
        <dl class="mt-8 grid gap-4 font-sans text-sm sm:grid-cols-2">
          <div>
            <dt class="kicker">Language</dt>
            <dd class="mt-1">{entry.language}</dd>
          </div>
          <div>
            <dt class="kicker">Where spoken / practiced</dt>
            <dd class="mt-1">{entry.region}</dd>
          </div>
        </dl>
      </div>
    </header>

    <div class="mx-auto max-w-6xl px-5 py-12 sm:px-8">
      <div class="measure prose-cav text-[1.05rem]">
        <p class="border border-rule bg-paper-raised px-4 py-3 font-sans text-sm text-ink-soft">
          This page is a sample of catalog form. It is not a finished CAV study and
          does not introduce invented sources.
        </p>
        <h2>Working note</h2>
        <p>{entry.summary}</p>
        <h2>Where generic English fails</h2>
        <p>{entry.whyGenericFails}</p>
        <h2>Diplomatic use</h2>
        <p>{entry.diplomaticNote}</p>
        <h2>Limits</h2>
        <p>{entry.caution}</p>
        <p>
          <a href="/catalog">Return to the catalog</a>
        </p>
      </div>
    </div>
  </article>
</BaseLayout>
